{
  // Visit https://aka.ms/tsconfig to read more about this file
  "compilerOptions": {
    // File Layout
    "rootDir": "./src",
    "outDir": "./dist",
    "lib": ["esnext"],
    "target": "esnext",
    "moduleResolution":"NodeNext",
    "module": "nodenext",
    "sourceMap": true,
    "declaration": true,
    "esModuleInterop": true,
    "strict": false,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.test.ts"]
  
}
